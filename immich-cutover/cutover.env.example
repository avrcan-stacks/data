# Keys only. Copy to cutover.env (0600, git-ignored) when the cutover is approved. No production secret belongs in this file:
# the DB password is read from /opt/stacks/immich/.env at execution time, API keys come from the operator's shell environment.
CUTOVER_ID=CHANGE_ME_YYYYMMDDtHHMMz
EVIDENCE_ROOT=/opt/stacks/data/backups
# expected production identities (verified by preflight.py)
EXPECT_SERVER_IMAGE=sha256:619fb163d959f4ee2f35f222ef23b2390ccba5e307ade748548834ad77aef463
EXPECT_BRIDGE_IMAGE=sha256:33e372cc42ccaa91156d5072e48836abb2e532063dfdc79aa30e17df333a3bf0
EXPECT_TARGET_IMAGE=sha256:e21ee65b5a53580b8f1e85b21ba0bf16f19c43d4dcc2ad49c4ce68a864a7cf51
# operator shell environment (never written to disk by the scripts):
#   IMMICH_ADMIN_API_KEY   temporary key of an admin, permissions: queue.read queue.update job.read job.create server.about server.statistics library.read library.statistics apiKey.read
#   IMMICH_USER_API_KEY    temporary key of ONE data-owning user, permissions: asset.read album.read person.read server.about
#   (both are created in the Immich UI before the window, revoked after the retention gate)
